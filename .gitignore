enterprise-crm.code-workspace

# ── .NET ────────────────────────────────────────────────────────────────────

# Build outputs
bin/
obj/
publish/
*.nupkg
*.snupkg

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# Test results
TestResults/
coverage/
*.coveragexml

# Aspire user secrets / local overrides
**/appsettings.*.local.json
**/Properties/launchSettings.json
# Exception: API projects need launchSettings committed so Aspire can discover their endpoints
!src/ProductManager/OpenHub.ProductManager.Api/Properties/launchSettings.json
!src/Administration/OpenHub.Administration.Api/Properties/launchSettings.json

# Azure Functions local-only dev settings (may contain local secrets)
local.settings.json

# ── React / Node ─────────────────────────────────────────────────────────────

node_modules/
dist/
.vite/
@mf-types/
*.tsbuildinfo

# Playwright output
test-results/
playwright-report/
blob-report/

# Local env overrides — .env.example is committed, locals are not
.env.local
.env.*.local

# ── Seed data ────────────────────────────────────────────────────────────────

# Large generated/imported catalogs for OpenHub.ProductManager.SeedTool's --csv-file mode
product_catalog_*.csv

# ── Local Docker Compose stack (infrastructure/docker) ──────────────────────
# Bind-mounted data directories created at container startup - not source.
infrastructure/docker/**/node[0-9]/
infrastructure/docker/postgres/pgadmin/
infrastructure/docker/redis/redisinsight/
infrastructure/docker/observability/prometheus/data/
infrastructure/docker/observability/grafana/data/
infrastructure/docker/observability/loki/data/
infrastructure/docker/observability/tempo/data/

# ── Editors / OS ─────────────────────────────────────────────────────────────

.vscode/
.DS_Store
Thumbs.db
*.log

# ── Local secrets and credentials (never commit; copy the .example templates) ─
.env
infrastructure/.secrets
infrastructure/k8s/.env
infrastructure/kubeconfig-act
infrastructure/k8s/kong/secret.yaml
infrastructure/k8s/postgres/pgadmin-secret.yaml
infrastructure/k8s/postgres/secret.yaml
infrastructure/k8s/reindex-job/secret.yaml
vault-init.json
*-init.json
