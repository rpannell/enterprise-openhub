<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OpenHub.RealtimeMessaging.Api</AssemblyName>
    <RootNamespace>OpenHub.RealtimeMessaging.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\OpenHub.Platform.ServiceDefaults\OpenHub.Platform.ServiceDefaults.csproj" />
    <ProjectReference Include="..\OpenHub.RealtimeMessaging.Contracts\OpenHub.RealtimeMessaging.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.0" />
    <!-- Pin below the version SignalR.StackExchangeRedis pulls in transitively: NuGet Audit flags
         MessagePack 2.5.187 (multiple CVEs) — MessagePack is SignalR's Redis-backplane wire
         format, unrelated to the REST/OpenAPI surface this project no longer has. Pinned to the
         latest patch within the same major version SignalR's MessagePack integration expects,
         not the breaking MessagePack 3.x rewrite. -->
    <PackageReference Include="MessagePack" Version="2.5.301" />
  </ItemGroup>

</Project>
