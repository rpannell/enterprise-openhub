VITE_KEYCLOAK_URL=https://keycloak.example.com
VITE_KEYCLOAK_CLIENT_ID=micro-ui-shell
# Fallback realm used only when the hostname has no recognizable subdomain (e.g. plain
# "localhost" in local dev). In production every tenant's subdomain maps to its own
# realm automatically — see src/keycloak.ts — so this is a dev convenience, not
# something a real deployment needs to set per tenant.
VITE_KEYCLOAK_DEFAULT_REALM=your-realm
