{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "Audience": "product-manager-api"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "appuser",
    "DurableExchange": true,
    "PersistentMessages": true
  },
  "Events": {
    "Product": {
      "ExchangeName": "product.changed"
    }
  }
}
