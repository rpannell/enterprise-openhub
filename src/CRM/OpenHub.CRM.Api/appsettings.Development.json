{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Auth": {
    "Audience": "crm-api"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "appuser",
    "DurableExchange": true,
    "PersistentMessages": true
  },
  "Events": {
    "Client": {
      "ExchangeName": "client.changed"
    }
  }
}
