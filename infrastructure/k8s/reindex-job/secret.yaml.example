# Template. Copy to secret.yaml, fill in, then `kubectl apply -f` it. The real file is git-ignored.
# Local development only. Never commit real values.
apiVersion: v1
kind: Secret
metadata:
  name: product-reindex-secrets
  namespace: reindex-job
type: Opaque
stringData:
  # Bootstrap credential only — everything else (Elasticsearch writer/reader API keys,
  # per-tenant and platform-admin Keycloak M2M client secrets) is pulled from Vault at
  # startup via AddVaultSecrets("platform", "product-manager-reindex-job"), the same
  # convention every other OpenHub service in this repo follows. Replace with a real
  # token issued to a policy scoped to that path before deploying to a real cluster.
  Vault__Token: "<set-me>"
  # Elasticsearch superuser connection string, used exactly once at startup to bootstrap
  # a scoped writer API key (see OpenHub.Accessor.ElasticIndex's README) — kept out of the
  # ConfigMap since it carries credentials.
  ConnectionStrings__Elasticsearch: "<set-me>"
