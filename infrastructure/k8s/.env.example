# Copy to infrastructure/k8s/.env (git-ignored) and fill in.
# Local development only. Never commit real values.

RABBITMQ_USER=<set-me>
RABBITMQ_PASSWORD=<set-me>
VAULT_ADDR=http://vault.vault.svc.cluster.local:8200
VAULT_TOKEN=<set-me>
KUBECONFIG=<absolute-path-to-your-kubeconfig>
VAULT_NAMESPACE=vault
RABBITMQ_NAMESPACE=rabbitmq-system
