# Template. Copy to secret.yaml, fill in, then `kubectl apply -f` it. The real file is git-ignored.
# Local development only. Never commit real values.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-credentials
  namespace: postgres
type: Opaque
stringData:
  POSTGRES_USER: "<set-me>"
  POSTGRES_PASSWORD: "<set-me>"
